{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/electron",
    "rootDir": ".",
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["./**/*"]
}
